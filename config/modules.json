{
  "version": 1,
  "modules": [
    { "kind": "provider", "id": "mihoyo", "entry": "packages/provider/mihoyo/src/index.mjs" },
    {
      "kind": "plugin", "id": "zzz", "entry": "packages/plugin/zzz/src/index.mjs",
      "namespace": { "prefix": "*", "aliases": ["zzz", "绝区零"], "priority": 100 }
    },
    {
      "kind": "channel", "id": "napcat", "entry": "packages/channel/napcat/src/index.mjs",
      "config": {
        "host": { "$env": "GAMEHUB_HOST", "default": "127.0.0.1" },
        "port": { "$env": "GAMEHUB_PORT", "default": 8080, "as":"number" },
        "path": { "$env": "GAMEHUB_PATH", "default": "/onebot/v11/ws" },
        "accessToken": { "$env": "NAPCAT_TO_GAMEHUB_CONNECTION_TOKEN", "required": true }
      }
    },
    { "kind": "provider", "id": "llm", "entry": "packages/provider/llm/src/index.mjs" },
    {
      "kind": "plugin", "id": "chat-ai", "entry": "packages/plugin/chat-ai/src/index.mjs",
      "namespace": { "prefix": "!", "aliases": ["！"], "priority": 50 }
    }
  ]
}
