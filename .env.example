# ==============================================================================
# Game-Hub + NapCat 统一环境配置模板 (.env)
# 严格遵循宿主机 Docker 全局集中化管理规范 (WSL Linux 真实绝对路径)
# ==============================================================================

# 1. 宿主机全局配置与数据根路径 (对齐现有服务栈规范)
CONFIG_ROOT=/home/bjrst/docker/config
DATA_ROOT=/home/bjrst/docker/data
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 2. 机器人 QQ 账号 (可选；未配置时直接访问 WebUI 进行二维码扫码登录)
QQ_ACCOUNT=

# 3. NapCat WebUI 管理面板宿主机映射端口 (默认 6099，访问 http://<宿主机IP>:6099/webui)
NAPCAT_WEBUI_PORT=6099

# 4. Game-Hub 网关 Access Token (内部反向 WebSocket 访问鉴权，增强安全性)
GAMEHUB_TOKEN=gamehub_secret_token_2026

# 5. chat-ai 模型密钥（只按 CHATAI_KEY_ 前缀从环境读取，不入库；档案里只存变量名）
CHATAI_KEY_MAIN=

# 6. chat-ai 管理员认证令牌（!AI认证 <token> 使用；留空表示不允许自助认证，只有系统管理员可操作）
CHATAI_ADMIN_TOKEN=

