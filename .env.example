# ==============================================================================
# Game-Hub 部署环境汇总模板 (.env)；各字段详细说明由所属包维护
# 严格遵循宿主机 Docker 全局集中化管理规范 (WSL Linux 真实绝对路径)
# ==============================================================================

# 1. 宿主机全局配置与数据根路径 (对齐现有服务栈规范)
CONFIG_ROOT=/home/bjrst/docker/config
DATA_ROOT=/home/bjrst/docker/data
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 2. NapCat 渠道（默认停用，可选 napcat profile）：详见 packages/channel/napcat/README.md
QQ_ACCOUNT=

# 3. NapCat WebUI 宿主机端口
NAPCAT_WEBUI_PORT=6099

# 4. NapCat → Game-Hub 连接令牌；双方配置与迁移见渠道包 README
NAPCAT_TO_GAMEHUB_CONNECTION_TOKEN=gamehub_secret_token_2026

# Telegram 渠道（当前默认）；字段细则见 packages/channel/telegram/README.md
TELEGRAM_BOT_API_TOKEN=
TELEGRAM_BOT_API_HTTPS_PROXY_URL=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# core 系统管理员注册令牌；留空关闭注册，详见 packages/core/README.md
GAMEHUB_ADMIN_REGISTRATION_TOKEN=

# core 可选环境预置管理员（平台:用户ID，逗号分隔）；撤权规则见 core 包 README
GAMEHUB_ADMIN_USERS=

# 5. 模型 API 密钥：详细说明见 packages/provider/llm/README.md
CHATAI_KEY_MAIN=

# 6. AI 插件管理员注册令牌；留空关闭注册，详见 packages/plugin/chat-ai/README.md
CHATAI_ADMIN_REGISTRATION_TOKEN=

